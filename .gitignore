node_modules
dist
*.local
.DS_Store

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# REFERENCE MEDIA DROPPED AT THE REPO ROOT - never publish, any of it.
#
# Licensed stock, client material, broadcaster templates and their media and fonts, kept on
# this machine for the harness and the teardown scripts to READ. None of it may reach GitHub
# or any other remote: it is not ours to publish, and this repository is public.
#
# The rule is deliberately the SHAPE rather than a list. Every one of these folders arrived
# unannounced - somebody dropped a set of examples in to be measured - and a list only ever
# covers the ones that already caused a scare. `example-stingers/` sat here untracked and
# un-ignored for a day, 309 MB of bought clips one `git add -A` away from being published.
# Anchored to the root, so nothing inside src/ or docs/ is caught by accident.
/example-*/
/example_*/

# Real-world SPX production projects, and the report scripts/spx-corpus-sweep.mjs writes.
spx_examples/
spx-corpus-out/

# Never commit API keys - copy .env.example to .env and fill it in locally.
.env

# Local MCP server config (e.g. project-scoped Supabase MCP) - points at a specific project,
# don't ship it in the open/self-hostable repo. Auth is handled separately via OAuth.
# The one exception is the noacg PLUGIN's server declaration (`npx -y noacg mcp`): it names no
# project and no secret, and a plugin without it has no MCP server (docs/AGENT_CLI.md).
.mcp.json
!cli/plugin/.mcp.json

# AI bench / comparison outputs (screenshots + generated code, regenerated on demand).
# The out-dir is the operator's choice, so the bench patterns are deliberately broad.
bench-*/
video-bench-out*/
video-benchmark-out/
compare-out*/
creative-route-out*/
creative-pilot-out*/
creative-rerun-out*/
creative-gallery/
# NoaCG Lite benchmark output (append-only local results, screenshots, motion clips,
# blind galleries, judgements - docs/AI_LITE_BENCHMARK.md; raw artifacts never commit)
lite-bench-out*/
pro-bench-out*/
lite-eval-out*/
# The §2 value gate's three arms, its blind sheet and the key that unblinds it
# (scripts/ai-lite-value-gate.mjs). The key must never be committed: it is the whole blind.
lite-value-gate-out*/
# The Pro feasibility round's two extra rigs (benchmarks/pro/round-2026-08-08): Lite driven over
# the Pro brief bank, and the state-machine generation probe with its emitted code.
lite-on-pro-out*/
pro-machine-out*/
# The Pro Phase 0 spike's captures (docs/NOACG_PRO_PLAN.md §0): hold frames, stress holds,
# virtual-clock motion strips, the blind gallery and its key.
pro-spike-out*/
# The recreate runner (scripts/import-recreate-spike.mjs): the masked reference, every round's
# hold and stress frame, the side-by-side gallery and the per-graphic import.html. The free
# --control run writes here too, so it appears without anyone choosing to spend a thing.
recreate-out*/
# The model-vs-harness four-arm study (scripts/model-vs-harness.mjs): saved generation code,
# lifecycle captures over the footage bed, the blind sheet and the key that unblinds it.
# The key must never be committed: it is the whole blind.
mvh-out*/
pro-brand-*/
# …and the same runner's Phase A rounds, wherever --out= puts them.
pro-lang-*/
# The stinger corpus brand-swap review rig (scripts/stinger-review.mjs): one page per stinger
# with the fonts and GSAP inlined. Regenerated on demand in one second.
stinger-review-out/
# The reference teardown's output (scripts/stinger-teardown.mjs): contact sheets and per-frame
# alpha series derived from the licensed clips ignored at the top of this file.
stinger-teardown-out/
# The gate's captured frames, sheets and alpha series (scripts/stinger-gate.mjs), and the
# sheets copied out of it for review. Hundreds of 1920x1080 PNGs; regenerated in two minutes.
stinger-gate-out/
stinger-sheets/

# The bench dev server's own output (scripts/dev-bench.mjs) - a local trace of how the
# server died, useful on this machine and meaningless anywhere else.
dev-bench.log

# Catalog sweep taste screenshots (scripts/l3-sweep.mjs <shots-dir> <category>; multi-MB
# PNGs, regenerated on demand - review them on disk, never commit them)
l3-shots/
shots/
shots-*/

# Local render outputs + manifest fixtures (multi-MB, regenerated on demand by
# scripts/make-render-manifest.mjs and the render dev loop)
.render-dev/

# Generated per-checkout by scripts/dev-port.mjs (postinstall): each worktree gets its own
# dev-server port, so these files must never be shared through git. dev-port.json is the
# published record of the port this checkout actually reserved (docs/DEV_PORTS.md).
.claude/launch.json
.claude/dev-port.json

# Locally installed third-party agent skills (npx skills add ...) - vendor content,
# reinstallable on demand, never committed. The skills this repo OWNS are re-included by
# name below: git cannot un-ignore a path inside an ignored DIRECTORY, so this ignores the
# directory's CONTENTS (/*) and lists the exceptions. Add a line when a first-party skill
# is added - otherwise it silently stays untracked.
.claude/skills/*
!.claude/skills/noacg-graphic/
!.claude/skills/ograf-expert/
!.claude/skills/spx-html-template-expert/
!.claude/skills/video-quality-round/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/check/
!.agents/skills/cleanup-worktrees/
!.agents/skills/handoff/
!.agents/skills/n/
!.agents/skills/next/
!.agents/skills/noacg-graphic/
!.agents/skills/noacg-task/
!.agents/skills/o/
!.agents/skills/ograf-expert/
!.agents/skills/orchestrator/
!.agents/skills/safe-merge/
!.agents/skills/so/
!.agents/skills/spx-html-template-expert/
!.agents/skills/start/
!.agents/skills/video-quality-round/
skills-lock.json

# re-design/ holds the approved redesign reference (handoff.md + the mockup PNGs) and IS
# committed, so every checkout and every session can see the pictures a change is measured
# against. Keep throwaway review screenshots out of it - put them in a scratch directory
# outside the repo rather than leaving the primary checkout permanently "dirty".

# Remotion deploy bundle (built by render-worker/bundle.mjs in the Vercel build step)
render-worker/bundle/

# Remotion Player host bundle (built by scripts/build-player-host.mjs into public/ on
# postinstall/build) - compiled Remotion code stays out of the AGPL repo, like the bundle above
public/player-host/

# Vercel CLI link pointer (project/org id - local only)
.vercel/

.vercel
.env*.local

# Generated bundled-font CSS for the render worker (from public/fonts)
render-worker/remotion/*.generated.ts

# Reference material dropped at the repo ROOT while working - format research spreadsheets,
# reference stills and screengrabs. Anchored with a leading / so real assets inside src/,
# public/ and docs/ are unaffected; nothing of this kind has ever been tracked at the root.
/*.xlsx
/*.png
/*.jpg
/*.jpeg
/*.JPG
/*.JPEG
/*.PNG

# Supabase CLI version-check cache - rewritten whenever a new CLI ships
supabase/.temp/cli-latest

# The compiled API runtime the node test runners and bench:preflight build. Cleaned up in a
# finally, but a killed run leaks one, and a leaked directory reads as an unmapped source
# change to scripts/e2e-affected.mjs (which then escalates to the full suite).
/.tmp-api-runtime-*/

# The acceptance pack's HOSTED-page rig (scripts/acceptance-pack.mjs, section `hosted`): an
# ordinary production build with the Supabase env pointed at a stub origin, served to the browser
# out of memory rather than by a server. It is a real bundle with fake credentials in it - never
# deploy it, never commit it, and it is rebuilt in seconds whenever that section runs.
/.tmp-hosted-build/
.env*

# npm auth for publishing the `noacg` CLI. The file itself holds no secret - it is
# `_authToken=${NPM_TOKEN}`, an ENV REFERENCE, and the token lives in .env above. It is ignored
# anyway for two reasons: committing it would point every contributor's npm at our registry auth
# line, and the day somebody pastes a literal token in here instead of the reference, git must
# already be refusing to take it.
.npmrc

# Local Lite test rig: a real bearer token, never committed.
.lite-token
lite-payload.tmp.json
*.tmp.mjs
# The free mark-field A/B (docs/NOACG_PRO_PLAN.md §15.8).
mark-field-ab/
pro-freeform-blind/
pro-iterate-out*/
pro-iterate-blind/
pro-typesweep-blind/
pro-spike-out-*.log
pro-iterate-out-*.log
