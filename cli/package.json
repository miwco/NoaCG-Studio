{
  "name": "noacg",
  "version": "0.2.0",
  "description": "The NoaCG Studio command-line tool and MCP server: scaffold, validate, inspect, screenshot and save broadcast graphics from a coding agent's terminal, against any NoaCG deployment.",
  "license": "AGPL-3.0-only",
  "author": "NoaCG Studio (https://noacg.studio)",
  "homepage": "https://noacg.studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miwco/NoaCG-Studio.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/miwco/NoaCG-Studio/issues"
  },
  "keywords": [
    "broadcast-graphics",
    "lower-third",
    "scoreboard",
    "ograf",
    "spx",
    "casparcg",
    "obs",
    "vmix",
    "mcp",
    "claude-code",
    "codex"
  ],
  "type": "module",
  "bin": {
    "noacg": "./dist/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-skill.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:skill": "node scripts/build-skill.mjs --check",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jszip": "3.10.1",
    "playwright-core": "1.61.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
