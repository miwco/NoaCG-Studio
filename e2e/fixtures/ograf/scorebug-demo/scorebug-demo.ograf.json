{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "demo-scorebug",
  "version": "1.0.0",
  "name": "Demo scorebug (third-party)",
  "description": "A hand-written OGraf Graphic that is NOT a NoaCG template: semantic data keys, two custom actions, two steps. The category-agnostic acceptance fixture (docs/AGENT_CLI.md).",
  "author": { "name": "A third party" },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "schema": {
    "type": "object",
    "properties": {
      "homeTeam": { "type": "string", "title": "Home team", "default": "HOME" },
      "awayTeam": { "type": "string", "title": "Away team", "default": "AWAY" },
      "homeGoals": { "type": "number", "title": "Home goals", "default": 0 },
      "awayGoals": { "type": "number", "title": "Away goals", "default": 0 },
      "competition": { "type": "string", "title": "Competition", "default": "Cup final", "hidden": true }
    }
  },
  "stepCount": 2,
  "customActions": [
    {
      "id": "goal",
      "name": "Goal!",
      "description": "Flash the scoring side.",
      "schema": { "type": "object", "properties": { "side": { "type": "string", "title": "Side", "enum": ["home", "away"], "default": "home" } } }
    },
    { "id": "reset", "name": "Reset score" }
  ],
  "renderRequirements": [{ "resolution": { "width": { "ideal": 1920 }, "height": { "ideal": 1080 } }, "frameRate": { "ideal": 25 } }]
}
