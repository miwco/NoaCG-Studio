{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "PowerShell(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "PowerShell(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm run check:*)",
      "PowerShell(npm run check:*)",
      "Bash(npm run catalog:affected)",
      "Bash(npm run catalog:affected *)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run jobs)",
      "Bash(npm run jobs *)",
      "PowerShell(npm run jobs)",
      "Bash(node scripts/jobs.mjs)",
      "Bash(node scripts/jobs.mjs log *)",
      "Bash(node scripts/jobs.mjs wait *)",
      "Bash(node scripts/blocked-sessions.mjs)",
      "Bash(node scripts/blocked-sessions.mjs *)",
      "Bash(node scripts/worktree-activity.mjs *)",
      "Bash(node scripts/merge-order.mjs)",
      "Bash(node scripts/merge-order.mjs *)",
      "Bash(node scripts/dev-port.mjs)",
      "Bash(node scripts/e2e-runs.mjs --wait)",
      "Bash(node scripts/e2e-runs.mjs --all)",
      "Bash(node scripts/e2e-runs.mjs --orphans)",
      "Bash(npm run queue:merge)",
      "PowerShell(npm run queue:merge)",
      "Bash(git fetch)",
      "Bash(git merge main)",
      "Bash(git merge origin/main)",
      "Bash(git merge --ff-only origin/main)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(git fetch *)",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__preview_stop",
      "mcp__Claude_Browser__preview_list",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__resize_window",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__tabs_create",
      "mcp__Claude_Browser__tabs_select",
      "mcp__Claude_Browser__tabs_close",
      "mcp__ccd_session__mark_chapter",
      "mcp__ccd_session__spawn_task",
      "mcp__ccd_session__dismiss_task",
      "mcp__ccd_session_mgmt__get_session",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_session_mgmt__search_session_transcripts"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node scripts/hooks/session-start.mjs" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/guard-command.mjs" }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/guard-edit.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/lint-file.mjs" }]
      }
    ]
  }
}
